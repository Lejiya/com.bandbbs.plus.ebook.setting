<template>
    <div class="page" onswipe="handleSwipe">
      <!-- 提示栏 -->
      <div class="prompt-bar">
        <text class="prompt-text">{{ isConfirm ? '请再次输入密码' : '请设置新密码' }}</text>
      </div>
  
      <!-- 密码显示区域 -->
      <div class="password-display">
        <text class="password-stars">{{ passwordStars }}</text>
      </div>
  
      <!-- 数字键盘区域 -->
      <div class="keyboard">
        <!-- 第1行: 1, 2, 3 -->
        <div class="row">
          <div class="key number-key" onclick="inputNum(1)">
            <text class="key-text number-text">1</text>
          </div>
          <div class="key number-key" onclick="inputNum(2)">
            <text class="key-text number-text">2</text>
          </div>
          <div class="key number-key" onclick="inputNum(3)">
            <text class="key-text number-text">3</text>
          </div>
        </div>
  
        <!-- 第2行: 4, 5, 6 -->
        <div class="row">
          <div class="key number-key" onclick="inputNum(4)">
            <text class="key-text number-text">4</text>
          </div>
          <div class="key number-key" onclick="inputNum(5)">
            <text class="key-text number-text">5</text>
          </div>
          <div class="key number-key" onclick="inputNum(6)">
            <text class="key-text number-text">6</text>
          </div>
        </div>
  
        <!-- 第3行: 7, 8, 9 -->
        <div class="row">
          <div class="key number-key" onclick="inputNum(7)">
            <text class="key-text number-text">7</text>
          </div>
          <div class="key number-key" onclick="inputNum(8)">
            <text class="key-text number-text">8</text>
          </div>
          <div class="key number-key" onclick="inputNum(9)">
            <text class="key-text number-text">9</text>
          </div>
        </div>
  
        <!-- 第4行: 清空, 0, 删除 -->
        <div class="row">
          <div class="key clear-key" onclick="clearPass">
            <text class="key-text func-text">清空</text>
          </div>
          <div class="key number-key" onclick="inputNum(0)">
            <text class="key-text number-text">0</text>
          </div>
          <div class="key delete-key" onclick="backspace">
            <text class="key-text delete-icon">←</text>
          </div>
        </div>
      </div>
    </div>
  </template>
  
  <style>
  .page {
    flex-direction: column;
    background-color: #000000;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }
  
  /* 提示栏 */
  .prompt-bar {
    width: 241px;
    height: 34px;
    background-color: #000000;
    justify-content: center;
    align-items: center;
    margin-bottom: 27px;
  }
  
  .prompt-text {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    font-family: HarmonyOS Sans, PingFang SC, San Francisco, system-ui;
  }
  
  /* 密码显示区域 */
  .password-display {
    width: 200px;
    height: 30px;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
  }
  
  .password-stars {
    color: #FFFFFF;
    font-size: 18px;
    letter-spacing: 8px;
    font-family: HarmonyOS Sans, PingFang SC, San Francisco, system-ui;
  }
  
  /* 键盘区域 */
  .keyboard {
    flex-direction: column;
    align-items: center;
  }
  
  .row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 13px;
  }
  
  /* 按键通用样式 */
  .key {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    justify-content: center;
    align-items: center;
    margin: 0 7px;
  }
  
  /* 数字键样式 */
  .number-key {
    background-color: #4A4F5A;
  }
  
  /* 清空键样式 */
  .clear-key {
    background-color: #2563EB;
  }
  
  /* 删除键样式 */
  .delete-key {
    background-color: #B91C1C;
  }
  
  /* 按键文字通用样式 */
  .key-text {
    color: #FFFFFF;
    font-family: HarmonyOS Sans, PingFang SC, San Francisco, system-ui;
  }
  
  /* 数字键文字大小 */
  .number-text {
    font-size: 21px;
    font-weight: bold;
  }
  
  /* 功能键文字大小 */
  .func-text {
    font-size: 12px;
    font-weight: bold;
  }
  
  /* 删除图标大小 */
  .delete-icon {
    font-size: 19px;
    font-weight: bold;
  }
  </style>
  
  <script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import storage from '../../utils/storage.js'
  
  export default {
    private: {
      password: '',      // 第一次输入的密码
      confirmPassword: '', // 第二次确认的密码
      isConfirm: false,   // 是否处于确认密码阶段
      minLength: 6,       // 最小密码长度
      maxLength: 6        // 最大密码长度
    },
  
    computed: {
      passwordStars() {
        let stars = ''
        const currentPwd = this.isConfirm ? this.confirmPassword : this.password
        for (let i = 0; i < currentPwd.length; i++) {
          stars += '● '
        }
        return stars.trim()
      }
    },
  
    inputNum(num) {
      const currentPwd = this.isConfirm ? this.confirmPassword : this.password
      
      // 限制最大长度
      if (currentPwd.length >= this.maxLength) {
        return
      }
      
      if (this.isConfirm) {
        this.confirmPassword = this.confirmPassword + num.toString()
        // 当确认密码输入完成时（达到与第一次密码相同长度）
        if (this.confirmPassword.length === this.password.length) {
          this.checkAndSave()
        }
      } else {
        this.password = this.password + num.toString()
        // 当第一次密码输入达到最小长度后，自动进入确认阶段
        if (this.password.length >= this.minLength) {
          this.isConfirm = true
        }
      }
    },
  
    checkAndSave() {
      // 验证两次密码是否一致
      if (this.password === this.confirmPassword) {
        // 保存密码到本地存储
        storage.set({
          key: 'EBOOK_PASSWORD',
          value: this.password
        })
        
        // 标记首次启动已完成
        storage.set({
          key: 'IS_FIRST_LAUNCH',
          value: false
        })
        
        prompt.showToast({
          message: '密码设置成功',
          duration: 1500
        })
        
        // 跳转到首页
        setTimeout(() => {
          router.replace({
            uri: '/pages/index'
          })
        }, 1500)
      } else {
        // 两次密码不一致，重置确认阶段
        prompt.showToast({
          message: '两次密码不一致，请重新设置',
          duration: 1500
        })
        
        setTimeout(() => {
          this.confirmPassword = ''
          this.password = ''
          this.isConfirm = false
        }, 1500)
      }
    },
  
    backspace() {
      if (this.isConfirm) {
        if (this.confirmPassword.length > 0) {
          this.confirmPassword = this.confirmPassword.substring(0, this.confirmPassword.length - 1)
        }
      } else {
        if (this.password.length > 0) {
          this.password = this.password.substring(0, this.password.length - 1)
        }
      }
    },
  
    clearPass() {
      if (this.isConfirm) {
        this.confirmPassword = ''
      } else {
        this.password = ''
      }
    },
  
    handleSwipe(e) {
      // 检测右滑手势返回
      if (e.direction === 4) {
        router.back()
      }
    }
  }
  </script>